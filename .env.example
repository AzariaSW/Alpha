API_KEY_PEPPER=
CORS_ORIGIN=
DATABASE_URL=
RABBITMQ_URL=
REDIS_URL=
PUBLIC_APP_URL=
# Set to true on a public demo deployment to show texted resume links on the "SMS outbox (demo)" tab.
# No real SMS provider is connected, so leave false anywhere real learners register.
DEMO_SMS_OUTBOX=false
# Number of reverse proxies in front of the app (1 on Render, Railway or behind nginx). 0 when exposed directly.
# Needed so rate limiting and resume links see the visitor's real IP and https scheme.
TRUST_PROXY=0
